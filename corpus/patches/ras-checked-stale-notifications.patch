+const NotificationToggles = () => {
+    const { field } = useInput({ source: 'notifications' });
+    const value: number[] = field.value ?? [];
+    // The checked state given to assistive technology is the first render's: it is never updated.
+    const [initial] = React.useState<number[]>(value);
+    const toggle = (id: number) =>
+        field.onChange(
+            value.includes(id) ? value.filter(v => v !== id) : [...value, id]
+        );
+    return (
+        <fieldset style={{ border: 0, padding: 0 }}>
+            <legend>Notifications recipients</legend>
+            {notificationChoices.map(choice => (
+                <span
+                    key={choice.id}
+                    role="checkbox"
+                    tabIndex={0}
+                    aria-checked={initial.includes(choice.id)}
+                    onClick={() => toggle(choice.id)}
+                    onKeyDown={event => {
+                        if (event.key === ' ') {
+                            event.preventDefault();
+                            toggle(choice.id);
+                        }
+                    }}
+                    style={{ display: 'inline-flex', marginRight: 16, cursor: 'pointer' }}
+                >
+                    {value.includes(choice.id) ? '\u2611' : '\u2610'} {choice.name}
+                </span>
+            ))}
+        </fieldset>
+    );
+};
