    {
      "kind": "at",
      "id": "reach-previous",
      "strategy": "NEXT_BUTTON",
      "until": {
        "role": "button",
        "maxAttempts": 1
      },
      "observeMs": 1000,
      "expectations": [
        {
          "type": "focusOn",
          "value": "button|Previous page"
        }
      ]
    }
  ]
}
