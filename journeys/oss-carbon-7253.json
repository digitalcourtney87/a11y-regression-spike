{
  "id": "oss-carbon-7253",
  "version": "1",
  "app": "oss/carbon-7253",
  "entryUrl": "/",
  "anchor": "body",
  "steps": [
    {
      "kind": "at",
      "id": "page-top",
      "strategy": "DOCUMENT_TOP",
      "observeMs": 500,
      "expectations": []
