{
  "id": "acrm-contact-merge-dialog",
  "version": "1",
  "app": "atomic-crm",
  "entryUrl": "/#/contacts/0",
  "anchor": "header a[href=\"#/deals\"]",
  "steps": [
    {
      "kind": "at",
      "id": "reach-merge",
      "strategy": "TAB",
      "until": {
        "name": "Merge with another contact",
        "role": "button",
        "maxAttempts": 100
      },
      "observeMs": 1000,
      "expectations": [
        {
          "type": "focusOn",
          "value": "button|Merge with another contact"
        }
      ]
    },
    {
      "kind": "at",
      "id": "open-merge",
      "strategy": "ACTIVATE",
      "observeMs": 2000,
      "expectations": [
        {
          "type": "focusOn",
          "value": "dialog|Merge Contact"
        }
      ]
    },
    {
      "kind": "at",
      "id": "leave-focus-mode",
      "strategy": "PRESS",
      "key": "Escape",
      "observeMs": 1000,
      "expectations": []
    },
    {
      "kind": "at",
      "id": "close-merge",
      "strategy": "PRESS",
      "key": "Escape",
      "observeMs": 1500,
      "expectations": [
        {
          "type": "focusOn",
          "value": "button|Merge with another contact"
        }
      ]
    }
  ]
}
