{
  "id": "m8-delayed-modal",
  "version": "1",
  "app": "m8-controls",
  "entryUrl": "/?case=delayed-modal",
  "anchor": "body",
  "steps": [
    {
      "kind": "at",
      "id": "reach-opener",
      "strategy": "TAB",
      "observeMs": 1000,
      "expectations": [],
      "until": {
        "name": "Open details",
        "role": "button",
        "maxAttempts": 5
      }
    },
    {
      "kind": "at",
      "id": "open-details",
      "strategy": "PRESS",
      "observeMs": 1000,
      "expectations": [],
      "key": "Enter",
      "until": {
        "name": "Details",
        "role": "dialog",
        "maxAttempts": 1
      }
    }
  ]
}
